[resource]
script = ExtResource("1_146rn")
id = "1"
title = "Хулиганы в таверне"
description = "Я управляю таверной \"Рокочущий ворон\" на севере нашего города и до недавнего времени дела шли просто отлично. А потом кто-то повадился писать непристойности прямо на стенах моей таверны! Я уверен, это дело рук моего конкурента, Бобби Шаромыги, и его шайки. Прошу вас, помогите мне найти и проучить этих паршивцев !"
deadline = 3
upfront = 20
reward = 80
positive_scenario = Array[ExtResource("2_result")]([ExtResource("3_outcome"), ExtResource("4_outcome")])
negative_scenario = Array[ExtResource("2_result")]([ExtResource("5_outcome")])
metadata/_custom_type_script = "uid://brf0d226jrpyi"
